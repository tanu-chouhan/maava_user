# Copy to .env.production before `npm run build` on the server or CI.
# NEVER use localhost values in production builds.

# API (required) — use your live domain
VITE_API_BASE_URL=https://switcheats.com/api/v1

# Uploaded images served by nginx at /uploads/
VITE_UPLOAD_BASE_URL=https://switcheats.com/uploads

# Google Maps JS API key — same key as the mobile apps (config/keys.env).
# Read it via ENV.GOOGLE_MAPS_API_KEY from src/config/env.js, never directly.
VITE_GOOGLE_MAPS_API_KEY=
